rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      // planはRevenueCat Webhook経由のCloud Functionsのみが更新する想定。
      allow write: if isOwner(userId);
    }

    // OAuthトークン・IMAPアプリパスワードはCloud Functions（Admin SDK）経由でのみ
    // 書き込む。アカウント作成（accessToken/refreshToken等を含む）もconnectAccount経由のみ。
    // ただしcolorHex（表示色）の変更と、連携解除（ドキュメント削除）はクライアントから直接行える
    // 必要があるため個別に許可する（以前は allow write: if false; で両方とも無言で失敗していた）。
    match /linkedAccounts/{accountId} {
      allow read: if isSignedIn() && resource != null && resource.data.userId == request.auth.uid;
      allow create: if false;
      allow update: if isSignedIn() && resource != null &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['colorHex']);
      allow delete: if isSignedIn() && resource != null &&
        resource.data.userId == request.auth.uid;
    }

    match /categoryRules/{ruleId} {
      allow read: if isSignedIn() &&
        (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource != null &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['category', 'retentionDays', 'accountId']);
      allow delete: if isSignedIn() && resource != null &&
        resource.data.userId == request.auth.uid;
    }

    match /senderBlockRules/{ruleId} {
      allow read: if isSignedIn() &&
        (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource != null &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['pattern', 'matchType', 'accountId']);
      allow delete: if isSignedIn() && resource != null &&
        resource.data.userId == request.auth.uid;
    }

    // emailMetaはCloud Functions（scanAccount等）が生成する。クライアントは
    // isPinned等の限定フィールドのみ更新可能にする（詳細はCloud Functions側で検証）。
    match /emailMeta/{emailId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isPinned', 'localCacheStatus', 'lastFetchedAt']);
      allow create, delete: if false;
    }

    match /archiveLogs/{logId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /cacheEvictionLogs/{logId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      // ローカルキャッシュ削除はクライアント側のみで完結するため、集計ログはクライアントが書く。
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
