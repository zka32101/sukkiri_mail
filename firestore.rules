rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      // planはRevenueCat Webhook経由のCloud Functionsのみが更新する想定。
      allow write: if isOwner(userId);
    }

    // OAuthトークン・IMAPアプリパスワードはCloud Functions（Admin SDK）経由でのみ
    // 書き込む。クライアントからの直接書き込みは禁止（アカウント作成もconnectAccount経由）。
    match /linkedAccounts/{accountId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /categoryRules/{ruleId} {
      allow read, write: if isSignedIn() &&
        (resource == null || resource.data.userId == request.auth.uid) &&
        request.resource.data.userId == request.auth.uid;
    }

    match /senderBlockRules/{ruleId} {
      allow read, write: if isSignedIn() &&
        (resource == null || resource.data.userId == request.auth.uid) &&
        request.resource.data.userId == request.auth.uid;
    }

    // emailMetaはCloud Functions（scanAccount等）が生成する。クライアントは
    // isPinned等の限定フィールドのみ更新可能にする（詳細はCloud Functions側で検証）。
    match /emailMeta/{emailId} {
      allow read: if isSignedIn();
      allow update: if isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isPinned', 'localCacheStatus', 'lastFetchedAt']);
      allow create, delete: if false;
    }

    match /archiveLogs/{logId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /cacheEvictionLogs/{logId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      // ローカルキャッシュ削除はクライアント側のみで完結するため、集計ログはクライアントが書く。
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
